# 号码认证服务（PNVS）的短信认证，仅服务端使用，区别于普通短信服务（SMS）。
# 复制为 .env.sms.local 后填写，已有文件不要覆盖。
ALIBABA_CLOUD_ACCESS_KEY_ID=your-restricted-ram-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-restricted-ram-access-key-secret
ALIYUN_SMS_SIGN_NAME=your-system-provided-pnvs-sign-name
# 从号码认证控制台复制赠送模板编号，例如 100001；不是 SMS_ 开头。
ALIYUN_SMS_TEMPLATE_CODE=your-numeric-pnvs-template-code
# 模板中的验证码变量名，通常是 code；按已审核模板填写。
ALIYUN_SMS_TEMPLATE_PARAM_NAME=code
# 模板中除了验证码的其他变量；与 Auth 五分钟有效期一致。
ALIYUN_SMS_TEMPLATE_PARAMS_JSON={"min":"5"}
# Supabase Auth Send SMS Hook 的签名密钥，部署准备时由本机生成。
SEND_SMS_HOOK_SECRET=your-server-only-webhook-signing-secret
