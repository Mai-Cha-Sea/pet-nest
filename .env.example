# 浏览器中只允许出现 Supabase 项目地址和公开 publishable/anon key。
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# 以下仅配置于 Supabase Edge Functions secrets，绝不要加 VITE_ 前缀。
DEEPSEEK_API_KEY=your-server-only-api-key
DEEPSEEK_MODEL=deepseek-flash
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY 由 Edge 运行时提供。
