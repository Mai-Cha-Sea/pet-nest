# 仅用于明确创建的非生产测试项目；使用已完成验证的账号或经管理接口确认的专用测试账号。
TEST_SUPABASE_URL=https://your-test-project.supabase.co
TEST_SUPABASE_ANON_KEY=your-test-project-public-key
TEST_USER_A_EMAIL=your-confirmed-test-email-a
TEST_USER_A_PASSWORD=your-private-password-a
TEST_USER_A_PHONE=your-confirmed-test-phone-a-with-country-code
TEST_USER_B_EMAIL=your-confirmed-test-email-b
TEST_USER_B_PASSWORD=your-private-password-b
TEST_USER_B_PHONE=your-confirmed-test-phone-b-with-country-code
# 必须显式 opt-in，脚本只清理本次创建的测试宠物及其记录。
TEST_ALLOW_WRITES=no
# AI 需要部署函数及服务端密钥；yes 会消耗最多一次真实调用额度/费用。
TEST_ENABLE_AI=no
# 高级并发验收另需服务端 TEST_ADMIN_KEY，并在测试进程显式开启；绝不要放入前端。
TEST_ALLOW_ADMIN_TESTS=no
